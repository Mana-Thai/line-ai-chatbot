# === LINEログイン(LIFF)===
# LINE Developers Console の LINE Login チャネルで作成した LIFF アプリの ID
LIFF_ID=your_liff_id_here
# LINE Login チャネルの「チャネルID」(IDトークン検証に使用)
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id_here

# === 管理者 ===
# 管理者モード(全注文の編集/削除)を解除するパスコード
ADMIN_PASSCODE=

# === データベース ===
# Supabase 等の PostgreSQL 接続文字列。未設定ならローカルJSONファイル保存(開発用)
DATABASE_URL=
# SSL無しのローカルPostgreSQLに繋ぐときだけ false にする(本番では設定しない。未設定=SSL有効)
# DATABASE_SSL=false

# === その他 ===
# セッショントークン署名用の秘密鍵(ランダムな長い文字列)
SESSION_SECRET=
# アプリのタイトル(省略可)
APP_TITLE=グッズ注文とりまとめ
PORT=3000

# ローカル開発専用:1にするとLINEログインなしで名前入力だけで使える(本番では絶対に設定しない)
# ALLOW_INSECURE_DEV=1

# === 旧チャットボット(休止中・`npm run chatbot` で使う。Renderには不要)===
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=

# === AI制作ツール(ローカル専用・Renderには不要)===
# Google AI Studio のAPIキー: https://aistudio.google.com/apikey
# 使うもの: artwork/tools/stylize.py(画像生成)/ gift-video/scripts/drama_clip.py(動画生成)
#           および旧チャットボット index.js
# ※動画生成(Veo)は無料枠では使えないため、キーに有料課金の設定が必要
GEMINI_API_KEY=
# fal.ai のAPIキー: https://fal.ai (Kling で動画生成する場合。--provider kling)
# セリフの無い作品はこちらの方が安く、人物の一貫性も強い
FAL_KEY=
